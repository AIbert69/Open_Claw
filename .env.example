# ============================================================
# OpenClaw + Orgo.ai Environment Variables
# ============================================================
# Copy this file to ~/.openclaw/.env and fill in your keys.
#
#   cp .env.example ~/.openclaw/.env
#
# ============================================================

# --- Orgo.ai ---
# Get your key at: https://www.orgo.ai/workspaces
ORGO_API_KEY=sk_live_your_orgo_key_here

# --- AI Provider (pick one or more) ---
# Anthropic (Claude) — recommended
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# OpenAI (optional fallback)
# OPENAI_API_KEY=sk-your_openai_key_here

# Google AI (optional fallback)
# GOOGLE_AI_API_KEY=your_google_key_here

# --- Messaging Channels (configure the ones you use) ---
# Telegram
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Discord
# DISCORD_BOT_TOKEN=your_discord_bot_token

# Slack
# SLACK_BOT_TOKEN=xoxb-your_slack_bot_token
