<div class="variant-selector">
  <span class="variant-selector__label">{{ option.name }}</span>
  <div class="variant-selector__options">
    {% for value in option.values %}
      {% assign variant_available = false %}
      {% for variant in product.variants %}
        {% if variant.options contains value and variant.available %}
          {% assign variant_available = true %}
          {% assign variant_id = variant.id %}
          {% break %}
        {% endif %}
      {% endfor %}

      <button type="button"
        class="variant-selector__option {% if option.selected_value == value %}is-selected{% endif %} {% unless variant_available %}is-unavailable{% endunless %}"
        data-variant-id="{{ variant_id }}"
        {% unless variant_available %}disabled{% endunless %}>
        {{ value }}
      </button>
    {% endfor %}
  </div>
</div>
